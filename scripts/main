import pandas as pd
from pathlib import Path
from sklearn.ensemble import RandomForestClassifier
from sklearn.preprocessing import LabelEncoder
from sklearn.metrics import confusion_matrix, precision_score, recall_score, f1_score
import matplotlib.pyplot as plt
import seaborn as sns

# paths
try:
    SCRIPTS_DIR = Path(__file__).resolve().parent
except (NameError, TypeError):
    SCRIPTS_DIR = Path.cwd()

DATA_DIR = SCRIPTS_DIR.parent / "data"

# load data
train = pd.read_csv(DATA_DIR / "train.csv")
test = pd.read_csv(DATA_DIR / "test.csv")
submission = pd.read_csv(DATA_DIR / "gender_submission.csv")

# fill missing values
train["Age"].fillna(train["Age"].median(), inplace=True)
test["Age"].fillna(test["Age"].median(), inplace=True)
test["Fare"].fillna(test["Fare"].median(), inplace=True)

# encode sex
le = LabelEncoder()
train["Sex"] = le.fit_transform(train["Sex"])
test["Sex"] = le.transform(test["Sex"])

# features
features = ["Pclass", "Sex", "Age", "SibSp", "Parch", "Fare"]
X_train = train[features]
y_train = train["Survived"]
X_test = test[features]
y_true = submission["Survived"]

# train model
model = RandomForestClassifier(n_estimators=100, random_state=42)
model.fit(X_train, y_train)
y_pred = model.predict(X_test)

# metrics
cm = confusion_matrix(y_true, y_pred)
precision = precision_score(y_true, y_pred)
recall = recall_score(y_true, y_pred)
f1 = f1_score(y_true, y_pred)

print("Confusion Matrix:")
print(cm)
print(f"\nPrecision: {precision:.2f}")
print(f"Recall:    {recall:.2f}")
print(f"F1 Score:  {f1:.2f}")

# confusion matrix plot
plt.figure(figsize=(6, 4))
sns.heatmap(cm, annot=True, fmt="d", cmap="Blues",
            xticklabels=["Predicted Dead", "Predicted Survived"],
            yticklabels=["Actually Dead", "Actually Survived"])
plt.title("Confusion Matrix")
plt.tight_layout()
plt.savefig(SCRIPTS_DIR / "confusion_matrix.png")
print("\nPlot saved to confusion_matrix.png")

# error analysis - look at one misclassified passenger
test_copy = test.copy()
test_copy["actual"] = y_true.values
test_copy["predicted"] = y_pred

# false negative = survived but predicted dead
fn = test_copy[(test_copy["actual"] == 1) & (test_copy["predicted"] == 0)]
example = fn.iloc[0]

print("\n--- Manual Error Analysis ---")
print(f"Passenger ID: {int(example['PassengerId'])}")
print(f"Pclass: {int(example['Pclass'])}, Sex (encoded): {int(example['Sex'])}, Age: {example['Age']}")
print(f"Actual: Survived, Predicted: Did not survive")
print("This passenger actually survived but the model predicted they wouldn't.")
print("Likely because they were in 3rd class with a low fare, which the model")
print("associated with not surviving. The model may have underweighted the gender feature.")